{
	"name": "@mrgr/mechanisms",
	"version": "0.1.0",
	"description": "File-level content merge mechanisms (git_text, gnu_diff3, mergiraf) under a normalized adapter contract, with per-attribute registration and an explicit binary macro.",
	"license": "Apache-2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/svnbjrn/mrgr.git",
		"directory": "packages/mechanisms"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"bin"
	],
	"engines": {
		"node": ">=22.5.0"
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"prepack": "pnpm run build",
		"test": "pnpm run build && vitest run",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"devDependencies": {
		"@types/node": "^22.5.0",
		"tsx": "^4.16.0",
		"typescript": "^5.5.0",
		"vitest": "^4.1.11"
	},
	"bin": {
		"mrgr-merge-driver": "bin/mrgr-merge-driver.mjs"
	}
}
